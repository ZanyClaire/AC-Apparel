<div class="wrap simple-page" style="max-width:520px">
  <h1>Create an account</h1>

  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="form-grid">
      <div class="field">
        <label for="RegisterFirst">First name</label>
        <input id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="RegisterLast">Last name</label>
        <input id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field field--full">
        <label for="RegisterEmail">Email</label>
        <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field field--full">
        <label for="RegisterPassword">Password</label>
        <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
    </div>

    <button class="btn" type="submit" style="margin-top:1.25rem">Create account</button>
  {%- endform -%}

  <p style="margin-top:1.5rem;font-size:.875rem">
    <a class="link-underline" href="{{ routes.account_login_url }}">Already have an account?</a>
  </p>
</div>
