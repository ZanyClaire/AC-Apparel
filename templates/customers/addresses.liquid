<div class="wrap simple-page">
  <h1>Addresses</h1>
  <p style="font-size:.875rem"><a class="link-underline" href="{{ routes.account_url }}">Back to account</a></p>

  {%- if customer.addresses.size > 0 -%}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:2rem">
      {%- for address in customer.addresses -%}
        <div style="border:1px solid var(--line);padding:1.25rem">
          {%- if address == customer.default_address -%}
            <p class="label">Default</p>
          {%- endif -%}
          {{ address | format_address }}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <h2 style="margin-top:2.5rem;font-size:var(--step-2)">Add an address</h2>

  {%- form 'customer_address', customer.new_address, class: 'address-form' -%}
    <div class="form-grid">
      <div class="field">
        <label for="AddressFirst">First name</label>
        <input id="AddressFirst" type="text" name="address[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="AddressLast">Last name</label>
        <input id="AddressLast" type="text" name="address[last_name]" autocomplete="family-name">
      </div>
      <div class="field field--full">
        <label for="Address1">Address</label>
        <input id="Address1" type="text" name="address[address1]" autocomplete="address-line1">
      </div>
      <div class="field">
        <label for="AddressCity">City</label>
        <input id="AddressCity" type="text" name="address[city]" autocomplete="address-level2">
      </div>
      <div class="field">
        <label for="AddressZip">Postcode</label>
        <input id="AddressZip" type="text" name="address[zip]" autocomplete="postal-code">
      </div>
      <div class="field field--full">
        <label for="AddressCountry">Country</label>
        <select id="AddressCountry" name="address[country]" data-default="{{ form.country }}">
          {{ country_option_tags }}
        </select>
      </div>
    </div>

    <div class="field" style="margin-top:1rem">
      <label for="AddressPhone">Phone</label>
      <input id="AddressPhone" type="tel" name="address[phone]" autocomplete="tel">
    </div>

    <button class="btn" type="submit" style="margin-top:1.25rem">Save address</button>
  {%- endform -%}
</div>

<script>
  (function () {
    var select = document.getElementById('AddressCountry');
    if (!select) return;
    var preferred = select.getAttribute('data-default');
    if (!preferred) return;
    for (var i = 0; i < select.options.length; i++) {
      if (select.options[i].value === preferred) {
        select.selectedIndex = i;
        break;
      }
    }
  })();
</script>
