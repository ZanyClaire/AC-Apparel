<div class="wrap simple-page" style="max-width:560px;margin-inline:auto">
  <p class="label">{{ shop.name }}</p>
  <h1>Opening shortly.</h1>
  <p class="muted">Enter the password to preview the storefront.</p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="field--inline" style="margin-top:1.5rem">
      <label for="Password" style="position:absolute;left:-9999px">Password</label>
      <input id="Password" type="password" name="password" placeholder="Password" style="flex:1;padding:.8rem .9rem;border:1px solid var(--line-strong);background:transparent;font:inherit">
      <button class="btn" type="submit">Enter</button>
    </div>
  {%- endform -%}
</div>
