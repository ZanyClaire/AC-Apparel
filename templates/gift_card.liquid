{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'Gift card' }} — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="gift-card">
  <main class="wrap simple-page" style="max-width:560px;margin-inline:auto">
    <p class="label">{{ shop.name }}</p>
    <h1>Gift card</h1>
    <p class="muted">Use this code at checkout. Digital wardrobe pieces can be redeemed with it too.</p>

    <div class="cart-summary" style="margin-top:2rem;position:static">
      <p class="label">Balance</p>
      <p style="font-family:var(--font-display);font-size:2rem;margin:0 0 1rem">{{ gift_card.balance | money }}</p>
      <p class="label">Code</p>
      <p style="font-family:var(--font-body);letter-spacing:.16em;font-size:1rem;margin:0">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expired -%}
        <p class="form-message form-message--error" style="margin-top:1.5rem">This gift card has expired.</p>
      {%- endif -%}
    </div>

    <p style="margin-top:2rem">
      <a class="btn" href="{{ shop.url }}">Continue shopping</a>
    </p>
  </main>
</body>
</html>
