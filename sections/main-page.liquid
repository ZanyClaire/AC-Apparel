<div class="wrap{% if section.settings.show_hero %} page-head{% endif %}" style="padding-bottom:var(--section)">
  {%- if section.settings.show_hero and section.settings.heading != blank -%}
    <h1>{{ section.settings.heading }}</h1>
  {%- endif -%}

  <div class="prose" style="max-width:68ch">
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page content",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show page title",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    }
  ],
  "presets": [{ "name": "Page content" }]
}
{% endschema %}
