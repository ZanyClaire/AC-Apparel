<div class="wrap page-head">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span>/</span>
    <span aria-current="page">{{ page.title }}</span>
  </nav>

  <h1>{{ section.settings.heading | default: page.title }}</h1>

  {%- if section.settings.text != blank -%}
    <div class="page-head__row">
      <div class="rte" style="max-width:52ch">{{ section.settings.text }}</div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
