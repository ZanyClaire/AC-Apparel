<section class="section" style="padding-top:clamp(1.5rem,3vw,2.5rem)">
  <div class="wrap split split--wide-left" style="align-items:start">
    <div>
      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1">
            {{ 'contact.success' | t }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-grid">
          <div class="field">
            <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
            <input
              id="ContactName-{{ section.id }}"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{% if customer %}{{ customer.name }}{% endif %}"
              required
            >
          </div>

          <div class="field">
            <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
            <input
              id="ContactEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              required
            >
          </div>

          <div class="field field--full">
            <label for="ContactSubject-{{ section.id }}">{{ 'contact.subject' | t }}</label>
            <select id="ContactSubject-{{ section.id }}" name="contact[subject]">
              <option>Sizing and fit</option>
              <option>An existing order</option>
              <option>Digital assets and licences</option>
              <option>Press or collaboration</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="field field--full">
            <label for="ContactMessage-{{ section.id }}">{{ 'contact.message' | t }}</label>
            <textarea
              id="ContactMessage-{{ section.id }}"
              name="contact[body]"
              placeholder="Order number if you have one."
              required
            ></textarea>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1.25rem;margin-top:1.5rem">
          <button class="btn" type="submit">
            {{ 'contact.send' | t }} <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </button>
          <p class="form-note" style="margin:0">{{ 'contact.note' | t }}</p>
        </div>
      {%- endform -%}
    </div>

    <div class="studio">
      {%- for block in section.blocks -%}
        <div class="studio__block" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <div class="rte" style="font-size:.875rem">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "max_blocks": 5,
  "settings": [],
  "blocks": [
    {
      "type": "detail",
      "name": "Studio detail",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Studio" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>14 Meridian Lane<br>London E2 7DP<br>United Kingdom</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        { "type": "detail", "settings": { "heading": "Studio" } },
        { "type": "detail", "settings": { "heading": "Email & telephone" } }
      ]
    }
  ]
}
{% endschema %}
