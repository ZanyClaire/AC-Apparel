<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="wordmark" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
        {%- if section.settings.brand_text != blank -%}
          <div class="rte" style="margin-top:.9rem">{{ section.settings.brand_text }}</div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'text' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <div class="rte" style="font-size:.8125rem">{{ block.settings.text }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__base">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.copyright_note }}</span>
      <span>
        {%- if section.settings.footer_note != blank -%}{{ section.settings.footer_note }}{%- endif -%}
      </span>
    </div>

    {%- if settings.social_instagram != blank or settings.social_substack != blank or settings.social_are_na != blank -%}
      <ul style="display:flex;gap:1.5rem;list-style:none;margin:1.25rem 0 0;padding:0">
        {%- if settings.social_instagram != blank -%}
          <li><a class="link-underline" href="{{ settings.social_instagram }}" rel="noopener">Instagram</a></li>
        {%- endif -%}
        {%- if settings.social_substack != blank -%}
          <li><a class="link-underline" href="{{ settings.social_substack }}" rel="noopener">Substack</a></li>
        {%- endif -%}
        {%- if settings.social_are_na != blank -%}
          <li><a class="link-underline" href="{{ settings.social_are_na }}" rel="noopener">Are.na</a></li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.25rem;opacity:.7">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand text",
      "default": "<p>Garments for the ground you stand on, with a digital twin for the ground you inhabit next.</p>"
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Copyright note",
      "default": "All rights reserved."
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer note",
      "default": "London · Reykjavík"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Elsewhere" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Studio" } },
        { "type": "text", "settings": { "heading": "Elsewhere" } }
      ]
    }
  ]
}
{% endschema %}
