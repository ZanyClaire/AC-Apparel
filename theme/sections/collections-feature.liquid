<section class="section section--tight" aria-labelledby="collections-title-{{ section.id }}">
  <div class="wrap">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="collections-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-underline" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{ section.settings.link_label }} <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="collections">
      {%- for block in section.blocks -%}
        {%- if forloop.first -%}
          {%- assign first_art = 'fog' -%}
          {%- render 'collection-card',
            card_collection: block.settings.collection,
            tall: true,
            art: first_art,
            attributes: block.shopify_attributes
          -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}
        <div class="collections__side">
          {%- for block in section.blocks offset: 1 -%}
            {%- assign side_art = 'dune' -%}
            {%- if forloop.index == 2 -%}{%- assign side_art = 'wire' -%}{%- endif -%}
            {%- render 'collection-card',
              card_collection: block.settings.collection,
              art: side_art,
              attributes: block.shopify_attributes
            -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collections" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Four ways into the wardrobe." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All pieces" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
