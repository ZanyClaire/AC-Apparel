{%- assign featured_collection = section.settings.collection -%}

<section class="section section--hair" aria-labelledby="featured-title-{{ section.id }}">
  <div class="wrap">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="featured-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <a
        class="link-underline"
        href="{{ section.settings.link | default: featured_collection.url | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.link_label }} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="grid-products">
      {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.limit -%}
          {%- assign art = 'studio' -%}
          {%- case forloop.index -%}
            {%- when 2 -%}{%- assign art = 'dune' -%}
            {%- when 3 -%}{%- assign art = 'ridge' -%}
          {%- endcase -%}
          {%- render 'product-card', card_product: product, art: art -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <div class="card">
            <div class="media">{% render 'plate', variant: 'studio' %}</div>
            <div class="card__info">
              <span class="card__name">Select a collection</span>
              <span class="card__price">&mdash;</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selected" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The pieces we wear most." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
