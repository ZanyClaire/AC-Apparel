{%- comment -%}
  Generated terrain art, used wherever a product or collection has no
  photography. Pass `variant`: ridge | fog | dune | studio | wire.
{%- endcomment -%}

{%- assign art = variant | default: 'studio' -%}

{%- case art -%}
  {%- when 'ridge' -%}
    {%- assign p1 = '#2b3a2e' -%}{%- assign p2 = '#5d6856' -%}{%- assign p3 = '#0c110d' -%}
  {%- when 'fog' -%}
    {%- assign p1 = '#22352b' -%}{%- assign p2 = '#4e6354' -%}{%- assign p3 = '#0b120e' -%}
  {%- when 'dune' -%}
    {%- assign p1 = '#5b5a4d' -%}{%- assign p2 = '#9a9482' -%}{%- assign p3 = '#2a2b24' -%}
  {%- when 'wire' -%}
    {%- assign p1 = '#1d2a22' -%}{%- assign p2 = '#3e6a52' -%}{%- assign p3 = '#0b0f0c' -%}
  {%- else -%}
    {%- assign p1 = '#3b3c35' -%}{%- assign p2 = '#8b8575' -%}{%- assign p3 = '#1a1b17' -%}
{%- endcase -%}

<div
  class="plate plate--{{ art }}"
  style="--p1:{{ p1 }};--p2:{{ p2 }};--p3:{{ p3 }}"
  aria-hidden="true"
>
  <span class="plate__contour"></span>
  <span class="plate__grain"></span>

  {%- if art == 'wire' -%}
    <div class="figure">
      <svg viewBox="0 0 200 470" aria-hidden="true">
        <circle cx="100" cy="38" r="17"/>
        <path d="M100 55v18"/>
        <path d="M72 82q28-12 56 0l10 106q-38 14-76 0z"/>
        <path d="M72 88c-11 34-14 78-11 122"/>
        <path d="M128 88c11 34 14 78 11 122"/>
        <path d="M70 196l-8 236h22l14-152"/>
        <path d="M130 196l8 236h-22l-14-152"/>
        <path class="dash" d="M62 210h76"/>
        <path class="dash" d="M64 330h72"/>
        <path class="accent" d="M34 120v-16h16"/>
        <path class="accent" d="M166 120v-16h-16"/>
        <path class="accent" d="M34 300v16h16"/>
        <path class="accent" d="M166 300v16h-16"/>
        <circle class="accent" cx="100" cy="38" r="26" stroke-opacity=".35"/>
        <path class="dash" d="M100 470V404"/>
      </svg>
    </div>
  {%- endif -%}
</div>
