<div class="wrap simple-page" style="max-width:520px">
  <h1>Reset password</h1>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="form-grid" style="grid-template-columns:1fr">
      <div class="field">
        <label for="ResetPassword">New password</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetConfirmation">Confirm password</label>
        <input id="ResetConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
    </div>

    <button class="btn" type="submit" style="margin-top:1.25rem">Reset password</button>
  {%- endform -%}
</div>
