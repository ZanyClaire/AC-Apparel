<div class="wrap page-head">
  <h1>{{ blog.title }}</h1>
</div>

<div class="wrap" style="padding-bottom:var(--section)">
  {%- paginate blog.articles by 9 -%}
    <div class="blog-list">
      {%- for article in blog.articles -%}
        <article>
          <a href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}
            {%- else -%}
              <div class="media" style="aspect-ratio:16/10">{% render 'plate', variant: 'dune' %}</div>
            {%- endif -%}
            <p class="label" style="margin-top:1rem">{{ article.published_at | date: '%d %B %Y' }}</p>
            <h2 style="font-size:var(--step-2)">{{ article.title }}</h2>
            <p class="muted" style="font-size:.875rem">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
          </a>
        </article>
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>
